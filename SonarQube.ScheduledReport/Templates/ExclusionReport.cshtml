<b>SonarQube Server Exclusion Report</b> @(Model.Projects.Count>0?"(rain)":"(sun)") @{int itemCount = 1;}
********************************************************************************************
@if (Model.Projects.Count > 0) {
foreach (var project in Model.Projects)
{
<b>@itemCount. </b><a href="http://sonarqube.nexdev.net/project/settings?category=exclusions&amp;id=@(project.Key.Key)">@(project.Key.Name):</a>
    foreach (var setting in project.Value)
    {
<b> - @setting.Name:</b> <i>@string.Join(", ", setting.Values)</i>
    }
<a href="http://rocketor.nexdev.net/SonarQubeReport/Index?projectKey=@(project.Key.Key)">More details...</a>
    if (itemCount < Model.Projects.Count)
    {
<i></i>
    }

    itemCount++;
}
<i></i>
<a href="http://rocketor.nexdev.net/SonarQubeReport/Index">Other Projects</a>
}
else
{
<i>There is no projects having the exclusion configurations.</i>
}
********************************************************************************************